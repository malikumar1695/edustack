# Template only — copy to .env.docker (gitignored) and fill in real values.
# NEVER put real keys or connection strings in this file: it is committed.

ALLOWED_ORIGINS=http://localhost:5174

AUTH_DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
ACADEMIC_DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# PEMs must be ONE line with newlines escaped as 
 — a multi-line value
# will not parse as an env var. Generate them in PowerShell with:
#   ((Get-Content appsuth-service\keys\private.pem -Raw) -replace "`r`n","
") -replace "`n","
"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
REPLACE_ME
-----END PRIVATE KEY-----
"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
REPLACE_ME
-----END PUBLIC KEY-----
"
