# ─── Dependencies ───────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/
.pnpm-store/

# ─── Lockfiles ──────────────────────────────────────────────────────────────
# NOTE: ignoring lockfiles means fresh installs may resolve different
# transitive versions than what was tested. Committing them is the norm.
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─── Build outputs ──────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ─── Generated code (regenerated from source; never hand-edited) ────────────
# Prisma clients are emitted by `prisma generate` from prisma/schema.
# Applies to every service, so services don't each need their own rule.
**/prisma/generated/
**/src/generated/
.prisma/

# ─── Environment (keep .env.example committed as documentation) ─────────────
# Ignore every env file by default, then re-include the committed templates.
# A deny-list (.env.local, .env.development, ...) misses new names like
# .env.docker — which is how a real signing key nearly got committed.
.env
.env.*
!.env.example
!.env.*.example

# ─── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Runtime / process ──────────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ─── Test / coverage ────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Caches ─────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.next/
.nuxt/
.vite/
.swc/

# ─── Editor / OS ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─── Legacy / scaffolding ───────────────────────────────────────────────────
apps/api/

# ─── AI assistant scaffolding (per-tool, regenerated by each contributor) ───
.agents/
.claude/
.windsurf/
.cursor/
.aider*
skills-lock.json
