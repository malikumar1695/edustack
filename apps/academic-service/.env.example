# Outbox sweeper schedule (6-field cron, leading field is seconds).
# "off" disables it. Above ~10 minutes it will never fire on Cloud Run,
# where idle instances are destroyed after about 15.
OUTBOX_RELAY_SCHEDULE=*/30 * * * * *
