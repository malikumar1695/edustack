model Student {
    id            String   @id @default(uuid())
    admissionNo   String   @unique
    firstName     String
    lastName      String
    dateOfBirth   DateTime
    gender        Gender
    guardianName  String
    guardianPhone String
    /// ISO 3166-1 alpha-2 of the guardian phone's country, e.g. "QA".
    /// Derived from guardianPhone on write — never taken from the client.
    phoneCountry  String   @db.Char(2)

    /// Where the student actually lives. Independent of the phone —
    /// expat families commonly have a foreign guardian number.
    countryOfResidence String @db.Char(2)

    // Reference to a User in auth-service. Deliberately NOT a relation:
    // separate databases mean no foreign key and no cross-service join.
    userId String? @unique
    loginUsername String? @unique

    // Denormalised at write time from the JWT — avoids a synchronous call to
    // auth-service just to display who created the record.
    createdByUserId   String
    createdByUsername String

    isDeleted Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isDeleted])
}
