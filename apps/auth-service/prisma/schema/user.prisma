model User {
  id                  String        @id @default(uuid())
  username            String        @unique
  passwordHash        String
  roles               UserRole[]    
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  refreshTokens       RefreshToken[]
}