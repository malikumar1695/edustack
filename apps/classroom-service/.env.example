PORT=4004
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174
RATE_LIMIT_MAX=300

# Its own database — database per service. A separate Neon database, not
# academic-service's.
DATABASE_URL=

# Public half of auth-service's RS256 keypair, inline with escaped newlines.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBg...\n-----END PUBLIC KEY-----\n"

# Called once per session start, to snapshot the class roster.
ACADEMIC_SERVICE_URL=http://localhost:4002

# LiveKit Cloud project → Settings → Keys. The secret signs join tokens:
# treat it exactly like the RS256 private key.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
