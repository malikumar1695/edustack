{
  "name": "ilm",
  "private": true,
  "description": "Ilm \u2014 school management platform (auth, academic, notification services + admin SPA)",
  "workspaces": [
    "packages/*",
    "apps/auth-service",
    "apps/academic-service",
    "apps/notification-service"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace @ilm/http-kit --workspace @ilm/auth-kit",
    "test:auth": "npm test --workspace @ilm/auth-service"
  },
  "overrides": {
    "prisma": "^7.10.0",
    "@prisma/client": "^7.10.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.7"
  }
}